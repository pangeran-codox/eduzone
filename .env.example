APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# --- Dipakai oleh docker-compose.yml (bukan Laravel) ---
# APP_TARGET: development | production — pilih stage Dockerfile mana yang dipakai
APP_TARGET=development
VITE_PORT=5174
NGINX_PORT=8083
REVERB_PORT=8082
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=eduzone
DB_USERNAME=laravel
DB_PASSWORD=secret123

# --- Koneksi kedua: database khusus modul Absensi (eduzone_absensi) ---
# Dipisah secara fisik dari DB utama karena volume event absensi tinggi
# (ratusan tap/scan per menit saat jam masuk). Lihat ARCHITECTURE.md §2.
DB_ABSENSI_CONNECTION=pgsql_absensi
DB_ABSENSI_HOST=postgres
DB_ABSENSI_PORT=5432
DB_ABSENSI_DATABASE=eduzone_absensi
DB_ABSENSI_USERNAME=laravel
DB_ABSENSI_PASSWORD=secret123

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# EduZone pakai index 0/1 (default Laravel). Redis instance ini SHARED sama
# project lain (Lab Management pakai 2/3) — kalau nambah project baru yang
# share Redis yang sama, pastikan pakai index yang belum kepake (increment
# 2: misal project berikutnya 4/5, dst) biar cache/queue/session nggak numpuk.
REDIS_DB=0
REDIS_CACHE_DB=1

# Isi REVERB_APP_ID/KEY/SECRET dengan nilai random kamu sendiri per environment
# (jangan pakai nilai contoh apapun) — generate misal lewat:
# php artisan reverb:install (kalau belum pernah), atau bikin manual string random.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Integrasi absensi-gateway (Go Fiber) ---
# Base URL gateway Go (nama service Docker + port internal container).
# Lewat NPM di-proxy dari /gateway → sini (lihat ARCHITECTURE.md §2.6).
ABSENSI_GATEWAY_BASE_URL=http://absensi-gateway-absensi-gateway-1:8080

# Shared-secret HS256 untuk JWT check-in guru via HP (endpoint Go /api/v1/checkin/teacher).
# HARUS SAMA PERSIS dengan JWT_SECRET di .env milik absensi-gateway.
# Kalau lupa isi, endpoint checkin guru akan selalu Unauthorized di sisi gateway.
ABSENSI_GATEWAY_JWT_SECRET=

# TTL token JWT dalam detik (default 15 menit = 900 detik)
ABSENSI_GATEWAY_JWT_TTL=900

# Token otentikasi server-to-server (Go → Laravel) untuk endpoint internal sync.
# HARUS SAMA PERSIS dengan LARAVEL_SYNC_TOKEN di .env milik absensi-gateway.
# Middleware VerifySyncToken reject request dengan 401 kalau ini kosong atau tidak cocok.
ABSENSI_SYNC_TOKEN=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
